# --- DeepSeek V4 Flash 0731 (deepseek/deepseek-v4-flash-0731) -> HF prefix deepseek_v4_flash_0731_ ---

iwac:deepseekV4Flash0731Centralite a owl:ObjectProperty ;
    rdfs:label "DeepSeek V4 Flash 0731 - Centrality"@en ;
    rdfs:label "DeepSeek V4 Flash 0731 - Centralité"@fr ;
    rdfs:comment "Level of centrality of Islam/Muslims according to DeepSeek V4 Flash 0731 (deepseek/deepseek-v4-flash-0731)"@en ;
    rdfs:comment "Niveau de centralité de l'islam/musulmans selon DeepSeek V4 Flash 0731 (deepseek/deepseek-v4-flash-0731)"@fr .

iwac:deepseekV4Flash0731CentraliteJustification a owl:DatatypeProperty ;
    rdfs:label "DeepSeek V4 Flash 0731 - Centrality Justification"@en ;
    rdfs:label "DeepSeek V4 Flash 0731 - Justification centralité"@fr ;
    rdfs:comment "DeepSeek V4 Flash 0731's explanation for the assigned centrality level"@en ;
    rdfs:comment "Explication de DeepSeek V4 Flash 0731 pour le niveau de centralité attribué"@fr ;
    rdfs:range xsd:string .

iwac:deepseekV4Flash0731Polarite a owl:ObjectProperty ;
    rdfs:label "DeepSeek V4 Flash 0731 - Polarity"@en ;
    rdfs:label "DeepSeek V4 Flash 0731 - Polarité"@fr ;
    rdfs:comment "Sentiment toward Islam/Muslims according to DeepSeek V4 Flash 0731 (deepseek/deepseek-v4-flash-0731)"@en ;
    rdfs:comment "Sentiment envers l'islam/musulmans selon DeepSeek V4 Flash 0731 (deepseek/deepseek-v4-flash-0731)"@fr .

iwac:deepseekV4Flash0731PolariteJustification a owl:DatatypeProperty ;
    rdfs:label "DeepSeek V4 Flash 0731 - Polarity Justification"@en ;
    rdfs:label "DeepSeek V4 Flash 0731 - Justification polarité"@fr ;
    rdfs:comment "DeepSeek V4 Flash 0731's explanation for the assigned polarity"@en ;
    rdfs:comment "Explication de DeepSeek V4 Flash 0731 pour la polarité attribuée"@fr ;
    rdfs:range xsd:string .

iwac:deepseekV4Flash0731SubjectiviteScore a owl:ObjectProperty ;
    rdfs:label "DeepSeek V4 Flash 0731 - Subjectivity Score"@en ;
    rdfs:label "DeepSeek V4 Flash 0731 - Score subjectivité"@fr ;
    rdfs:comment "Labelled subjectivity level according to DeepSeek V4 Flash 0731 (deepseek/deepseek-v4-flash-0731), linked to controlled vocabulary item"@en ;
    rdfs:comment "Niveau de subjectivité libellé selon DeepSeek V4 Flash 0731 (deepseek/deepseek-v4-flash-0731), lié à un élément de vocabulaire contrôlé"@fr .

iwac:deepseekV4Flash0731SubjectiviteJustification a owl:DatatypeProperty ;
    rdfs:label "DeepSeek V4 Flash 0731 - Subjectivity Justification"@en ;
    rdfs:label "DeepSeek V4 Flash 0731 - Justification subjectivité"@fr ;
    rdfs:comment "DeepSeek V4 Flash 0731's explanation for the subjectivity score"@en ;
    rdfs:comment "Explication de DeepSeek V4 Flash 0731 pour le score de subjectivité"@fr ;
    rdfs:range xsd:string .


