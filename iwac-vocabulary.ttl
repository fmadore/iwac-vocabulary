@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix iwac: <https://islam.zmo.de/ontology/iwac#> .

# ============================================
# ONTOLOGY DECLARATION
# ============================================

iwac: a owl:Ontology ;
    rdfs:label "IWAC Ontology"@en ;
    rdfs:label "Ontologie IWAC"@fr ;
    dcterms:title "IWAC Ontology"@en ;
    dcterms:title "Ontologie IWAC"@fr ;
    rdfs:comment "Vocabulary for the Islam West Africa Collection, covering AI processing provenance and sentiment analysis metadata"@en ;
    rdfs:comment "Vocabulaire pour la Collection Islam Afrique de l'Ouest, couvrant la provenance du traitement IA et les métadonnées d'analyse de sentiment"@fr ;
    dcterms:description "Vocabulary for the Islam West Africa Collection, covering AI processing provenance and sentiment analysis metadata"@en ;
    dcterms:description "Vocabulaire pour la Collection Islam Afrique de l'Ouest, couvrant la provenance du traitement IA et les métadonnées d'analyse de sentiment"@fr ;
    dcterms:created "2026-01-26"^^xsd:date ;
    dcterms:modified "2026-11-27"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-0959-2092> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    vann:preferredNamespacePrefix "iwac" ;
    vann:preferredNamespaceUri "https://islam.zmo.de/ontology/iwac#" ;
    owl:versionIRI <https://raw.githubusercontent.com/fmadore/iwac-vocabulary/v1.7/iwac-vocabulary.ttl> ;
    owl:versionInfo "1.7" .

# ============================================
# AI PROVENANCE PROPERTIES
# (Used as value annotations)
# ============================================

iwac:ocrModel a owl:ObjectProperty ;
    rdfs:label "AI Model - OCR"@en ;
    rdfs:label "Modèle IA - OCR"@fr ;
    rdfs:comment "AI model used for optical character recognition and text extraction"@en ;
    rdfs:comment "Modèle d'IA utilisé pour la reconnaissance optique de caractères et l'extraction de texte"@fr ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:isDefinedBy iwac: .

iwac:summaryModel a owl:ObjectProperty ;
    rdfs:label "AI Model - Summary"@en ;
    rdfs:label "Modèle IA - Résumé"@fr ;
    rdfs:comment "AI model used to generate summaries or descriptions"@en ;
    rdfs:comment "Modèle d'IA utilisé pour générer des résumés ou descriptions"@fr ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:isDefinedBy iwac: .

iwac:descriptionModel a owl:ObjectProperty ;
    rdfs:label "AI Model - Description"@en ;
    rdfs:label "Modèle IA - Description"@fr ;
    rdfs:comment "AI model that drafted the description of an authority record (person, organisation, subject, place, event)"@en ;
    rdfs:comment "Modèle d'IA ayant rédigé la description d'une notice d'autorité (personne, organisation, sujet, lieu, événement)"@fr ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:isDefinedBy iwac: .

iwac:nerModel a owl:ObjectProperty ;
    rdfs:label "AI Model - NER"@en ;
    rdfs:label "Modèle IA - NER"@fr ;
    rdfs:comment "AI model used for named entity recognition"@en ;
    rdfs:comment "Modèle d'IA utilisé pour la reconnaissance d'entités nommées"@fr ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:isDefinedBy iwac: .

iwac:transcriptionModel a owl:ObjectProperty ;
    rdfs:label "AI Model - Transcription"@en ;
    rdfs:label "Modèle IA - Transcription"@fr ;
    rdfs:comment "AI model used for audio/video transcription"@en ;
    rdfs:comment "Modèle d'IA utilisé pour la transcription audio/vidéo"@fr ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:isDefinedBy iwac: .

iwac:processingDate a owl:DatatypeProperty ;
    rdfs:label "AI Processing Date"@en ;
    rdfs:label "Date de traitement IA"@fr ;
    rdfs:comment "Date when AI processing was performed"@en ;
    rdfs:comment "Date à laquelle le traitement IA a été effectué"@fr ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy iwac: .

iwac:confidence a owl:DatatypeProperty ;
    rdfs:label "AI Confidence Score"@en ;
    rdfs:label "Score de confiance IA"@fr ;
    rdfs:comment "Confidence score of the AI model output (0-1)"@en ;
    rdfs:comment "Score de confiance de la sortie du modèle IA (0-1)"@fr ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy iwac: .

iwac:modelVersion a owl:DatatypeProperty ;
    rdfs:label "AI Model Version"@en ;
    rdfs:label "Version du modèle IA"@fr ;
    rdfs:comment "Specific version of the AI model used"@en ;
    rdfs:comment "Version spécifique du modèle IA utilisé"@fr ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy iwac: .

# ============================================
# SENTIMENT PROPERTIES — GENERATION 2 (2026-07)
# ============================================
#
# Named for the MODEL, not the vendor. The property name is the
# searchable provenance: Omeka does not index value annotations.
# iwac:sentimentModel remains below only to preserve historical data;
# the current pipeline does not write it.
#
# Centralité, polarité and the subjectivité score are links into the
# controlled vocabulary, so they are ObjectProperties here. Each
# per-model property is linked to a shared dimension super-property
# via rdfs:subPropertyOf.
#
# The panel is defined once in AI_sentiment_analysis/sentiment_core.py
# (PANEL); this block is generated from it by 00_setup_properties.py.

iwac:sentimentModel a owl:ObjectProperty ;
    rdfs:label "AI Model - Sentiment"@en ;
    rdfs:label "Modèle IA - Sentiment"@fr ;
    rdfs:comment "Legacy value-annotation link to the AI model; retained for historical data but not written by the current model-keyed panel"@en ;
    rdfs:comment "Ancien lien d'annotation de valeur vers le modèle d'IA ; conservé pour les données historiques mais non écrit par le panel actuel"@fr ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    owl:deprecated true ;
    rdfs:isDefinedBy iwac: .

# --- Abstract dimension super-properties ---

iwac:centralite a owl:ObjectProperty ;
    rdfs:label "Sentiment - Centrality"@en ;
    rdfs:label "Sentiment - Centralité"@fr ;
    rdfs:comment "Abstract super-property for model-keyed centrality ratings of Islam/Muslims"@en ;
    rdfs:comment "Super-propriété abstraite pour les niveaux de centralité de l'islam/musulmans par modèle"@fr ;
    rdfs:isDefinedBy iwac: .

iwac:centraliteJustification a owl:DatatypeProperty ;
    rdfs:label "Sentiment - Centrality Justification"@en ;
    rdfs:label "Sentiment - Justification centralité"@fr ;
    rdfs:comment "Abstract super-property for model-keyed explanations of assigned centrality levels"@en ;
    rdfs:comment "Super-propriété abstraite pour les explications du niveau de centralité attribué par modèle"@fr ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy iwac: .

iwac:polarite a owl:ObjectProperty ;
    rdfs:label "Sentiment - Polarity"@en ;
    rdfs:label "Sentiment - Polarité"@fr ;
    rdfs:comment "Abstract super-property for model-keyed sentiment polarity ratings toward Islam/Muslims"@en ;
    rdfs:comment "Super-propriété abstraite pour les polarités de sentiment envers l'islam/musulmans par modèle"@fr ;
    rdfs:isDefinedBy iwac: .

iwac:polariteJustification a owl:DatatypeProperty ;
    rdfs:label "Sentiment - Polarity Justification"@en ;
    rdfs:label "Sentiment - Justification polarité"@fr ;
    rdfs:comment "Abstract super-property for model-keyed explanations of assigned polarity ratings"@en ;
    rdfs:comment "Super-propriété abstraite pour les explications de la polarité attribuée par modèle"@fr ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy iwac: .

iwac:subjectiviteScore a owl:ObjectProperty ;
    rdfs:label "Sentiment - Subjectivity Score"@en ;
    rdfs:label "Sentiment - Score subjectivité"@fr ;
    rdfs:comment "Abstract super-property for model-keyed subjectivity ratings"@en ;
    rdfs:comment "Super-propriété abstraite pour les niveaux de subjectivité par modèle"@fr ;
    rdfs:isDefinedBy iwac: .

iwac:subjectiviteJustification a owl:DatatypeProperty ;
    rdfs:label "Sentiment - Subjectivity Justification"@en ;
    rdfs:label "Sentiment - Justification subjectivité"@fr ;
    rdfs:comment "Abstract super-property for model-keyed explanations of assigned subjectivity scores"@en ;
    rdfs:comment "Super-propriété abstraite pour les explications du score de subjectivité par modèle"@fr ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy iwac: .


