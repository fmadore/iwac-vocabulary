@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iwac: <https://islam.zmo.de/ontology/iwac#> .

# ============================================
# ONTOLOGY DECLARATION
# ============================================

iwac: a owl:Ontology ;
    rdfs:label "IWAC Ontology"@en ;
    rdfs:label "Ontologie IWAC"@fr ;
    rdfs:comment "Vocabulary for the Islam West Africa Collection, covering AI processing provenance and sentiment analysis metadata"@en ;
    rdfs:comment "Vocabulaire pour la Collection Islam Afrique de l'Ouest, couvrant la provenance du traitement IA et les métadonnées d'analyse de sentiment"@fr ;
    dcterms:created "2026-01-26"^^xsd:date ;
    dcterms:modified "2026-08-14"^^xsd:date ;
    dcterms:creator "Frédérick Madore" ;
    owl:versionInfo "1.3" .

# ============================================
# AI PROVENANCE PROPERTIES
# (Used as value annotations)
# ============================================

iwac:ocrModel a owl:DatatypeProperty ;
    rdfs:label "AI Model - OCR"@en ;
    rdfs:label "Modèle IA - OCR"@fr ;
    rdfs:comment "AI model used for optical character recognition and text extraction"@en ;
    rdfs:comment "Modèle d'IA utilisé pour la reconnaissance optique de caractères et l'extraction de texte"@fr ;
    rdfs:range xsd:string .

iwac:summaryModel a owl:DatatypeProperty ;
    rdfs:label "AI Model - Summary"@en ;
    rdfs:label "Modèle IA - Résumé"@fr ;
    rdfs:comment "AI model used to generate summaries or descriptions"@en ;
    rdfs:comment "Modèle d'IA utilisé pour générer des résumés ou descriptions"@fr ;
    rdfs:range xsd:string .

iwac:nerModel a owl:DatatypeProperty ;
    rdfs:label "AI Model - NER"@en ;
    rdfs:label "Modèle IA - NER"@fr ;
    rdfs:comment "AI model used for named entity recognition"@en ;
    rdfs:comment "Modèle d'IA utilisé pour la reconnaissance d'entités nommées"@fr ;
    rdfs:range xsd:string .

iwac:transcriptionModel a owl:DatatypeProperty ;
    rdfs:label "AI Model - Transcription"@en ;
    rdfs:label "Modèle IA - Transcription"@fr ;
    rdfs:comment "AI model used for audio/video transcription"@en ;
    rdfs:comment "Modèle d'IA utilisé pour la transcription audio/vidéo"@fr ;
    rdfs:range xsd:string .

iwac:processingDate a owl:DatatypeProperty ;
    rdfs:label "AI Processing Date"@en ;
    rdfs:label "Date de traitement IA"@fr ;
    rdfs:comment "Date when AI processing was performed"@en ;
    rdfs:comment "Date à laquelle le traitement IA a été effectué"@fr ;
    rdfs:range xsd:date .

iwac:confidence a owl:DatatypeProperty ;
    rdfs:label "AI Confidence Score"@en ;
    rdfs:label "Score de confiance IA"@fr ;
    rdfs:comment "Confidence score of the AI model output (0-1)"@en ;
    rdfs:comment "Score de confiance de la sortie du modèle IA (0-1)"@fr ;
    rdfs:range xsd:decimal .

iwac:modelVersion a owl:DatatypeProperty ;
    rdfs:label "AI Model Version"@en ;
    rdfs:label "Version du modèle IA"@fr ;
    rdfs:comment "Specific version of the AI model used"@en ;
    rdfs:comment "Version spécifique du modèle IA utilisé"@fr ;
    rdfs:range xsd:string .

# ============================================
# SENTIMENT PROPERTIES — GENERATION 2 (2026-07)
# ============================================
#
# Named for the MODEL, not the vendor. The property name is the
# searchable provenance: Omeka does not index value annotations.
# iwac:sentimentModel remains below only to preserve historical data;
# the current pipeline does not write it.
#
# Centralité, polarité and the subjectivité score are links into the
# controlled vocabulary, so they are ObjectProperties here.
#
# The panel is defined once in AI_sentiment_analysis/sentiment_core.py
# (PANEL); this block is generated from it by 00_setup_properties.py.

iwac:sentimentModel a owl:ObjectProperty ;
    rdfs:label "AI Model - Sentiment"@en ;
    rdfs:label "Modèle IA - Sentiment"@fr ;
    rdfs:comment "Legacy value-annotation link to the AI model; retained for historical data but not written by the current model-keyed panel"@en ;
    rdfs:comment "Ancien lien d'annotation de valeur vers le modèle d'IA ; conservé pour les données historiques mais non écrit par le panel actuel"@fr .

# --- Gemma 4 31B (google/gemma-4-31b-it) -> HF prefix gemma_4_31b_it_ ---

iwac:gemma431bItCentralite a owl:ObjectProperty ;
    rdfs:label "Gemma 4 31B - Centrality"@en ;
    rdfs:label "Gemma 4 31B - Centralité"@fr ;
    rdfs:comment "Level of centrality of Islam/Muslims according to Gemma 4 31B (google/gemma-4-31b-it)"@en ;
    rdfs:comment "Niveau de centralité de l'islam/musulmans selon Gemma 4 31B (google/gemma-4-31b-it)"@fr .

iwac:gemma431bItCentraliteJustification a owl:DatatypeProperty ;
    rdfs:label "Gemma 4 31B - Centrality Justification"@en ;
    rdfs:label "Gemma 4 31B - Justification centralité"@fr ;
    rdfs:comment "Gemma 4 31B's explanation for the assigned centrality level"@en ;
    rdfs:comment "Explication de Gemma 4 31B pour le niveau de centralité attribué"@fr ;
    rdfs:range xsd:string .

iwac:gemma431bItPolarite a owl:ObjectProperty ;
    rdfs:label "Gemma 4 31B - Polarity"@en ;
    rdfs:label "Gemma 4 31B - Polarité"@fr ;
    rdfs:comment "Sentiment toward Islam/Muslims according to Gemma 4 31B (google/gemma-4-31b-it)"@en ;
    rdfs:comment "Sentiment envers l'islam/musulmans selon Gemma 4 31B (google/gemma-4-31b-it)"@fr .

iwac:gemma431bItPolariteJustification a owl:DatatypeProperty ;
    rdfs:label "Gemma 4 31B - Polarity Justification"@en ;
    rdfs:label "Gemma 4 31B - Justification polarité"@fr ;
    rdfs:comment "Gemma 4 31B's explanation for the assigned polarity"@en ;
    rdfs:comment "Explication de Gemma 4 31B pour la polarité attribuée"@fr ;
    rdfs:range xsd:string .

iwac:gemma431bItSubjectiviteScore a owl:ObjectProperty ;
    rdfs:label "Gemma 4 31B - Subjectivity Score"@en ;
    rdfs:label "Gemma 4 31B - Score subjectivité"@fr ;
    rdfs:comment "Labelled subjectivity level according to Gemma 4 31B (google/gemma-4-31b-it), linked to controlled vocabulary item"@en ;
    rdfs:comment "Niveau de subjectivité libellé selon Gemma 4 31B (google/gemma-4-31b-it), lié à un élément de vocabulaire contrôlé"@fr .

iwac:gemma431bItSubjectiviteJustification a owl:DatatypeProperty ;
    rdfs:label "Gemma 4 31B - Subjectivity Justification"@en ;
    rdfs:label "Gemma 4 31B - Justification subjectivité"@fr ;
    rdfs:comment "Gemma 4 31B's explanation for the subjectivity score"@en ;
    rdfs:comment "Explication de Gemma 4 31B pour le score de subjectivité"@fr ;
    rdfs:range xsd:string .


